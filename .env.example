# Скопируйте в .env.local и подставьте значения своего проекта Supabase
# (Project Settings → API Keys). Здесь ТОЛЬКО публичные значения.
# secret / service_role ключ сюда и во фронтенд не кладём никогда.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
